<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Openings_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Openings must be zero or greater.</description>
    <errorConditionFormula>Openings__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Openings__c</errorDisplayField>
    <errorMessage>Openings cannot be negative.</errorMessage>
</ValidationRule>
